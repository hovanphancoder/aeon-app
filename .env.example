# ==========================================
# AEON BOOKING & ACTIVATION SYSTEM CONFIG
# ==========================================

# -----------------
# 1. API SERVER
# -----------------
PORT=3000
NODE_ENV=development

# -----------------
# 2. DATABASE (MySQL)
# -----------------
DATABASE_URL="mysql://root:password@localhost:3306/aeon_booking?schema=public"

# -----------------
# 3. JWT AUTHENTICATION
# -----------------
JWT_SECRET="aeon_super_secret_jwt_key_hai_duong_2026_change_in_production"
JWT_EXPIRES_IN="24h"

# -----------------
# 4. CORS CONFIGURATION
# Có thể truyền danh sách phân tách bởi dấu phẩy, hoặc để * trong local dev
# -----------------
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# -----------------
# 5. ZALO ZNS OTP CONFIG
# Chọn provider: "mock" (in ra log console/response cho dev) hoặc "zalo" (production)
# -----------------
ZNS_PROVIDER="mock"
ZALO_APP_ID="your_zalo_app_id"
ZALO_SECRET_KEY="your_zalo_secret_key"
ZALO_TEMPLATE_ID="your_zalo_template_id"
ZALO_ACCESS_TOKEN="your_zalo_access_token"

# -----------------
# 6. FILE STORAGE CONFIG
# Chọn provider: "local", "cloudinary", hoặc "s3"
# Trên Vercel / Production: Khuyên dùng "cloudinary"
# -----------------
STORAGE_PROVIDER="cloudinary"
STORAGE_PATH="./uploads"
STORAGE_PUBLIC_URL="/uploads"

# Cloudinary (Khuyên dùng cho Vercel - Miễn phí 25GB)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="aeon_bills"

# S3 (nếu dùng STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""

# -----------------
# 7. FRONTEND CONFIG (VITE)
# Trong môi trường dev, có thể để trống để dùng relative path (/api) qua Vite Proxy
# Khi deploy production, điền URL của API (Ví dụ: https://api.yourdomain.com)
# -----------------
VITE_API_URL=""
