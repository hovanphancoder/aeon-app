{
  "name": "aeon-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "AEON Hai Duong Booking & Activation System Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces",
    "db:generate": "npm run prisma:generate --workspace=apps/api",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "keywords": [
    "aeon",
    "booking",
    "activation",
    "monorepo"
  ],
